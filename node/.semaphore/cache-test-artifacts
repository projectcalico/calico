# This script is run locally to push the FV test artifacts to our sub-directory
# in GCS. The counterpart to this script is load-test-artifacts, which runs on
# the test VM.  It can assume that the artifacts have been downloaded to /tmp.
#
# fv-artifacts are published to GCS (GCS_WORKFLOW_DIR) rather than the S3 build
# cache so the in-cloud GCP test VMs fetch them without cross-cloud egress. The
# source images, however, live on S3 (S3_WORKFLOW_DIR), published there by the
# "Build: *" prerequisite blocks, so this script bridges the two backends:
# `s3-cmd` (S3) to fetch, `gcloud storage` (GCS) to publish.

set -e
set -x

# Resolve the repo root (and the helpers under it) before we cd out of the
# component directory — below we cd to the repo's *parent* to tar it up.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
S3_CMD="${REPO_ROOT}/.semaphore/s3-cmd"
LOAD_CACHED_IMAGES="${REPO_ROOT}/.semaphore/load-cached-images"

cd ../..

# Fetch pre-built images from the S3 workflow cache if available, and re-upload
# them into the GCS fv-artifacts directory for the test VM.
# These were built by the "Build: *" blocks in the Prerequisites stage.
#
# A build without S3 credentials runs read-only (see .semaphore/s3-cmd), so
# those blocks had nowhere to publish their tarballs. On a miss, fall back to
# load-cached-images, which builds the image from source in that case (and, with
# credentials, leaves a genuine miss alone), then save it out of the daemon.
# load-test-artifacts on the VM falls back to building from source, which the
# VM cannot do, so a `docker save` failing here — no cached copy and no local
# image — is the right loud failure.
for img in calico node whisker; do
  tarball="${img}-image.tar.zst"
  if "$S3_CMD" cp "${S3_WORKFLOW_DIR}/${tarball}" "/tmp/${tarball}" 2>/dev/null; then
    echo "Found pre-built ${tarball}, including in artifacts."
  else
    echo "No ${tarball} in the S3 workflow cache; building and saving it locally"
    # load-cached-images resolves the repo from its working directory.
    (cd "${REPO_ROOT}" && "$LOAD_CACHED_IMAGES" "${img}")
    docker save "calico/${img}:latest-amd64" -o "/tmp/${img}-image.tar"
    zstd -3 --rm "/tmp/${img}-image.tar"
  fi
  gcloud storage cp "/tmp/${tarball}" "${GCS_WORKFLOW_DIR}/node/fv-artifacts/${tarball}"
done

tar -czf /tmp/working-copy.tgz \
  --exclude=${CALICO_DIR_NAME}/artifacts \
  ${CALICO_DIR_NAME}
gcloud storage cp /tmp/working-copy.tgz "${GCS_WORKFLOW_DIR}/node/fv-artifacts/"
