# Generated by confd
{{- $config := getBGPConfig 6 . }}

{{$route_added := false}}
template static static_template {
{{- $block_key := printf "/ipam/v2/host/%s/ipv6/block" $config.NodeName}}
{{- if ls $block_key}}
{{- $route_added = true}}
   # IP blocks for this host.
{{- range ls $block_key}}
{{- $parts := split . "-"}}
{{- $cidr := join $parts "/"}}
{{- if not (hasSuffix $cidr "/128")}}
   route {{$cidr}} blackhole;
{{- end}}
{{- end}}
{{- end}}
{{- $static_key := "/staticroutesv6"}}
{{- if ls $static_key}}
{{- $route_added = true}}
   # Static routes.
{{- range ls $static_key}}
{{- $parts := split . "-"}}
{{- $cidr := join $parts "/"}}
   route {{$cidr}} blackhole;
{{- end}}
{{- end}}
{{- $run_once := true}}
{{- range $config.Peers}}
{{- if and .IP .ReachableBy (eq .Type "global")}}
{{- if $run_once}}
{{- $route_added = true}}
{{- $run_once = false}}
   # Static routes needed for global BGP peers.
{{- end}}
   route {{.IP}}/128 via {{.ReachableBy}};
{{- end}}
{{- end}}
{{- $run_once := true}}
{{- range $config.Peers}}
{{- if and .IP .ReachableBy (eq .Type "node")}}
{{- if $run_once}}
{{- $route_added = true}}
{{- $run_once = false}}
   # Static routes needed for node specific BGP peers.
{{- end}}
   route {{.IP}}/128 via {{.ReachableBy}};
{{- end}}
{{- end}}
{{- if not $route_added}}
   # No IP blocks or static routes for this host.
{{- end}}
}

{{ if $route_added }}
protocol static from static_template {
}
{{ end }}

# Aggregation of routes on this host; export the block, nothing beneath it.
function calico_aggr ()
{
{{- range ls $block_key}}
{{- $parts := split . "-"}}
{{- $cidr := join $parts "/"}}
{{- $affinity := json (getv (printf "%s/%s" $block_key .))}}
  {{- if $affinity.state}}
      # Block {{$cidr}} is {{$affinity.state}}
    {{- if eq $affinity.state "confirmed"}}
      if ( net = {{$cidr}} ) then { accept; }
      if ( net ~ {{$cidr}} && krt_metric < {{$config.NormalRoutePriority}} ) then { accept; }
      if ( net ~ {{$cidr}} ) then { reject; }
    {{- end}}
  {{- else }}
      # Block {{$cidr}} is implicitly confirmed.
      if ( net = {{$cidr}} ) then { accept; }
      if ( net ~ {{$cidr}} && krt_metric < {{$config.NormalRoutePriority}} ) then { accept; }
      if ( net ~ {{$cidr}} ) then { reject; }
  {{- end }}
{{- end}}
}
