{
  "apiVersion": "projectcalico.org/v3",
  "kind": "GlobalNetworkPolicy",
  "metadata": {
    "name": "calico-system.node-local-dns"
  },
  "spec": {
    "tier":"calico-system",
    "order":10,
    "selector": "projectcalico.org/namespace in {'calico-system'}",
    "egress":[
       {
         "action":"Allow",
         "protocol":"UDP",
         "source":{},
         "destination":{
           "nets": ["2002:a60:a::"],
           "ports": ["53"]
         }
       }
    ],
    "types":[
      "Egress"
    ]
  }
}
