{
  "apiVersion": "projectcalico.org/v3",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "calico-system.dex",
    "namespace": "tigera-dex"
  },
  "spec": {
    "order": 1,
    "tier": "calico-system",
    "selector": "k8s-app == 'tigera-dex'",
    "types": [
      "Ingress",
      "Egress"
    ],
    "ingress": [
      {
        "action": "Allow",
        "protocol": "TCP",
        "source": {
          "selector": "k8s-app == 'calico-manager'",
          "namespaceSelector": "kubernetes.io/metadata.name == 'calico-system'"
        },
        "destination": {
          "ports": [
            5556
          ]
        }
      },
      {
        "action": "Allow",
        "protocol": "TCP",
        "source": {
          "selector": "k8s-app == 'tigera-secure-es-gateway'",
          "namespaceSelector": "kubernetes.io/metadata.name == 'tigera-elasticsearch'"
        },
        "destination": {
          "ports": [
            5556
          ]
        }
      },
      {
        "action": "Allow",
        "destination": {
          "ports": [
            5556
          ]
        },
        "protocol": "TCP",
        "source": {
          "selector": "k8s-app == 'tigera-packetcapture'",
          "namespaceSelector": "kubernetes.io/metadata.name == 'tigera-packetcapture'"
        }
      },
      {
        "action": "Allow",
        "destination": {
          "ports": [
            5556
          ]
        },
        "protocol": "TCP",
        "source": {
          "selector": "k8s-app == 'tigera-prometheus'",
          "namespaceSelector": "name == 'tigera-prometheus'"
        }
      },
      {
        "action": "Allow",
        "destination": {
          "ports": [
            5556
          ]
        },
        "protocol": "TCP",
        "source": {
          "selector": "k8s-app == 'calico-apiserver'",
          "namespaceSelector": "kubernetes.io/metadata.name == 'calico-system'"
        }
      }
    ],
    "egress": [
      {
        "action": "Allow",
        "protocol": "UDP",
        "destination": {
          "namespaceSelector": "kubernetes.io/metadata.name == 'openshift-dns'",
          "selector": "dns.operator.openshift.io/daemonset-dns == 'default'",
          "ports": [
            5353
          ]
        }
      },
      {
        "action": "Allow",
        "protocol": "TCP",
        "destination": {
          "namespaceSelector": "kubernetes.io/metadata.name == 'openshift-dns'",
          "selector": "dns.operator.openshift.io/daemonset-dns == 'default'",
          "ports": [
            5353
          ]
        }
      },
      {
        "action": "Allow",
        "protocol": "TCP",
        "destination": {
          "services": {
            "name": "kubernetes",
            "namespace": "default"
          }
        }
      },
      {
        "action": "Allow",
        "protocol": "TCP",
        "destination": {
          "ports": [
            443,
            6443,
            389,
            636
          ],
          "nets": [
            "0.0.0.0/0"
          ]
        }
      },
      {
        "action": "Allow",
        "protocol": "TCP",
        "destination": {
          "ports": [
            443,
            6443,
            389,
            636
          ],
          "nets": [
            "::/0"
          ]
        }
      }
    ]
  }
}
