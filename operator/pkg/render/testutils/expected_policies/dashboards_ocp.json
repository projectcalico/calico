{
  "apiVersion": "projectcalico.org/v3",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "calico-system.dashboards-installer",
    "namespace": "tigera-elasticsearch"
  },
  "spec": {
    "order": 1,
    "tier": "calico-system",
    "selector": "job-name == 'dashboards-installer'",
    "types": [
      "Egress"
    ],
    "egress": [
      {
        "action": "Allow",
        "protocol": "UDP",
        "destination": {
          "namespaceSelector": "kubernetes.io/metadata.name == 'openshift-dns'",
          "selector": "dns.operator.openshift.io/daemonset-dns == 'default'",
          "ports": [
            5353
          ]
        }
      },
      {
        "action": "Allow",
        "protocol": "TCP",
        "destination": {
          "namespaceSelector": "kubernetes.io/metadata.name == 'openshift-dns'",
          "selector": "dns.operator.openshift.io/daemonset-dns == 'default'",
          "ports": [
            5353
          ]
        }
      },
      {
        "action": "Allow",
        "protocol": "TCP",
        "destination": {
          "namespaceSelector": "kubernetes.io/metadata.name == 'tigera-kibana'",
          "selector": "k8s-app == 'tigera-secure'",
          "ports": [
            5601
          ]
        }
      }
    ]
  }
}
