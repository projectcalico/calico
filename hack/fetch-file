#!/usr/bin/env bash
# Download a file. Use instead of curl in build files.
#
#   hack/fetch-file <url> <dest>
#
# GitHub throttles HTTP/2 harder than HTTP/1.1, and CI runners share a source
# IP. A token would not help: these URLs are CDN-served and not rate limited
# by identity, and a stale one makes raw.githubusercontent.com return 404.
set -euo pipefail

if [ $# -ne 2 ]; then
	echo "usage: $0 <url> <dest>" >&2
	exit 1
fi

url=$1
dest=$2

mkdir -p "$(dirname "$dest")"
curl --fail --silent --show-error --location \
	--http1.1 \
	--retry 5 --retry-all-errors \
	--output "$dest" \
	"$url"
