diff --git a/sysdep/linux/netlink.c b/sysdep/linux/netlink.c
index f4fb9f7e..7613f274 100644
--- a/sysdep/linux/netlink.c
+++ b/sysdep/linux/netlink.c
@@ -26,6 +26,7 @@
 #include "lib/string.h"
 #include "lib/hash.h"
 #include "conf/conf.h"
+#include "proto/bgp/bgp.h"
 
 #include <asm/types.h>
 #include <linux/if.h>
@@ -936,6 +937,7 @@ static int
 nl_send_route(struct krt_proto *p, rte *e, struct ea_list *eattrs, int op, int dest, ip_addr gw, struct iface *iface)
 {
   eattr *ea;
+  eattr *nh;
   net *net = e->net;
   rta *a = e->attrs;
   u32 priority = 0;
@@ -945,6 +947,7 @@ nl_send_route(struct krt_proto *p, rte *e, struct ea_list *eattrs, int op, int d
     struct rtmsg r;
     char buf[0];
   } *r;
+  struct iface* i;
 
   uint rsize = sizeof(*r) + 128 + KRT_METRICS_MAX*8 + nh_bufsize(a->nexthops);
   r = alloca(rsize);
@@ -1023,8 +1026,23 @@ dest:
     {
     case RTD_ROUTER:
       r->r.rtm_type = RTN_UNICAST;
-      nl_add_attr_u32(&r->h, rsize, RTA_OIF, iface->index);
-      nl_add_attr_ipa(&r->h, rsize, RTA_GATEWAY, gw);
+      if ((ea = ea_find(eattrs, EA_KRT_TUNNEL)) &&
+          (nh = ea_find(eattrs, EA_CODE(EAP_BGP, BA_NEXT_HOP))) &&
+          (i = if_find_by_name(ea->u.ptr->data)))
+      {
+        /*
+         * Tunnel attribute is set, so set the route up using the specified tunnel device
+         * to the originator of the route.
+         */
+        nl_add_attr_u32(&r->h, rsize, RTA_OIF, i->index);
+        nl_add_attr_ipa(&r->h, rsize, RTA_GATEWAY, *(ip_addr *)(nh->u.ptr->data));
+        r->r.rtm_flags |= RTNH_F_ONLINK;
+      }
+      else
+      {
+         nl_add_attr_u32(&r->h, rsize, RTA_OIF, iface->index);
+         nl_add_attr_ipa(&r->h, rsize, RTA_GATEWAY, gw);
+      }
       break;
     case RTD_DEVICE:
       r->r.rtm_type = RTN_UNICAST;
@@ -1722,6 +1740,10 @@ krt_sys_get_attr(eattr *a, byte *buf, int buflen UNUSED)
     bsprintf(buf, "scope");
     return GA_NAME;
 
+  case EA_KRT_TUNNEL:
+    bsprintf(buf, "tunnel");
+    return GA_NAME;
+
   case EA_KRT_LOCK:
     buf += bsprintf(buf, "lock:");
     ea_format_bitfield(a, buf, buflen, krt_metrics_names, 2, KRT_METRICS_MAX);
diff --git a/sysdep/unix/krt.c b/sysdep/unix/krt.c
index 526c0cab..c625da2c 100644
--- a/sysdep/unix/krt.c
+++ b/sysdep/unix/krt.c
@@ -657,7 +657,17 @@ krt_same_dest(rte *k, rte *e)
   switch (ka->dest)
     {
     case RTD_ROUTER:
-      return ipa_equal(ka->gw, ea->gw);
+	  /* Calico-BIRD specific: in addition to checking that the gw is the same, we
+	   * also check that the interface is as expected - this covers the case where
+	   * a route was previously using the IPIP tunnel but is no longer: the gateway
+	   * may be the same but the interface will be different.  The calculated
+	   * interface index will be for the non-tunl route. Only at the point the route
+	   * is programmed in nl_send_route does the tunnel index get calculated.
+	   * Therefore the check performed here is not valid when the route should be
+	   * over the tunnel - hence there is an an explicit check in krt_got_route for
+	   * the tunnel scenario, and in that case krt_same_dest is not invoked.
+	   */
+      return ipa_equal(ka->gw, ea->gw) && ka->iface->index == ea->iface->index;
     case RTD_DEVICE:
       return !strcmp(ka->iface->name, ea->iface->name);
     case RTD_MULTIPATH:
@@ -720,7 +730,9 @@ krt_got_route(struct krt_proto *p, rte *e)
   if (net->n.flags & KRF_INSTALLED)
     {
       rte *new, *rt_free;
-      ea_list *tmpa;
+      ea_list *tmpa = NULL;
+      eattr *ea = NULL;
+      struct iface* i = NULL;
 
       new = krt_export_net(p, net, &rt_free, &tmpa);
 
@@ -728,10 +740,28 @@ krt_got_route(struct krt_proto *p, rte *e)
 
       if (!new)
 	verdict = KRF_DELETE;
-      else if ((net->n.flags & KRF_SYNC_ERROR) || !krt_same_dest(e, new))
+      else if ((net->n.flags & KRF_SYNC_ERROR))
 	verdict = KRF_UPDATE;
-      else
-	verdict = KRF_SEEN;
+      else if (tmpa &&
+	  (e->attrs->dest == RTD_ROUTER) &&
+	  (ea = ea_find(tmpa, EA_KRT_TUNNEL)) &&
+	  (i = if_find_by_name(ea->u.ptr->data)))
+	{
+	  /* Calico-BIRD specific: we check if the export filter set a tunnel
+	   * attribute for the route.  If it did, and the tunnel interface is
+	   * different from the outgoing interface that is already programmed
+	   * for the route, generate KRF_UPDATE here so that the route gets
+	   * updated to have the tunnel as its outgoing interface.
+	   */
+	  if (!strcmp(i->name, e->attrs->iface->name))
+	    verdict = KRF_SEEN;
+	  else
+	    verdict = KRF_UPDATE;
+	}
+	else if(!krt_same_dest(e, new))
+	  verdict = KRF_UPDATE;
+	else
+	  verdict = KRF_SEEN;
 
       if (rt_free)
 	rte_free(rt_free);
