commit 25738fac55bea1ec1b2b02a07d59e54fced990d2
Author: Giorgos Mavrikas <georgios@mavrikas.com>
Date:   2022-03-10

    Match the broadcast address before the 240.0.0.0/4 CIDR
---
 lib/ip.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/lib/ip.c b/lib/ip.c
index 2050d19e..0463eb6e 100644
--- a/lib/ip.c
+++ b/lib/ip.c
@@ -97,12 +97,15 @@ ip4_classify(ip4_addr ad)
       return IADDR_HOST | SCOPE_UNIVERSE;
   }
 
-  if (b >= 0xe0 && b <= 0xef)
-    return IADDR_MULTICAST | SCOPE_UNIVERSE;
-
   if (a == 0xffffffff)
     return IADDR_BROADCAST | SCOPE_LINK;
 
+  if (b >= 0xf0)
+      return IADDR_HOST | SCOPE_SITE;
+
+  if (b >= 0xe0 && b <= 0xef)
+    return IADDR_MULTICAST | SCOPE_UNIVERSE;
+
   return IADDR_INVALID;
 }
 
