{
  "index_patterns": ["benchmark_data_policy_eval_*"],
  "template": {
    "mappings": {
      "properties": {
        "@timestamp":        {"type": "date"},
        "git_commit":        {"type": "keyword"},
        "git_branch":        {"type": "keyword"},
        "code_version":      {"type": "keyword"},
        "ci_run_id":         {"type": "keyword"},
        "pr_number":         {"type": "keyword"},
        "env":               {"type": "keyword"},
        "test_name":         {"type": "keyword"},
        "case":              {"type": "keyword"},
        "direction":         {"type": "keyword"},
        "cached":            {"type": "boolean"},
        "ok":                {"type": "boolean"},
        "error":             {"type": "keyword"},
        "iterations":        {"type": "integer"},
        "workers":           {"type": "integer"},

        "scale_rules":       {"type": "integer"},
        "scale_ipsets":      {"type": "integer"},
        "scale_live_flows":  {"type": "integer"},
        "repeat_fraction":   {"type": "double"},

        "wall_ns_per_op":    {"type": "double"},
        "ns_per_flow":       {"type": "double"},
        "flows_per_s":       {"type": "double"},
        "throughput":        {"type": "double"},
        "hit_ratio":         {"type": "double"},
        "bytes_per_op":      {"type": "double"},
        "allocs_per_op":     {"type": "double"}
      }
    }
  }
}
