#!/bin/bash
# TEMPORARY: unpacks the Go build and module caches go-cache or go-mod-cache left
# on the volume cache, in place of restoring them from GCS. A VM step is handed
# only the module archive, so whichever archives the directory holds are
# restored. The go-build image has unpigz and ci-base only gzip; either way the
# disk, not decompression, is the limit.
set -euo pipefail

step=${1:?usage: restore-go-cache <step> [cache-dir]}
dir=${2:-/cache/go}
# A VM has no GO_MOD_ROOT; lib.Makefile mounts ~/go/pkg/mod into its builds.
mod_root=${GO_MOD_ROOT:-${HOME}/go}
gunzip=gzip
if command -v unpigz >/dev/null; then gunzip=unpigz; fi

if [ ! -f "${dir}/go-build.tar.gz" ] && [ ! -f "${dir}/go-mod.tar.gz" ]; then
  echo "restore-go-cache: no Go cache archives in ${dir}" >&2
  exit 1
fi

start=$(date +%s)
pids=()
if [ -f "${dir}/go-build.tar.gz" ]; then
  "${gunzip}" -dc "${dir}/go-build.tar.gz" | tar -C "${CI_HOME}/${CI_GIT_DIR}" -xf - &
  pids+=($!)
fi
if [ -f "${dir}/go-mod.tar.gz" ]; then
  mkdir -p "${mod_root}"
  "${gunzip}" -dc "${dir}/go-mod.tar.gz" | tar -C "${mod_root}" -xf - &
  pids+=($!)
fi
for pid in "${pids[@]}"; do wait "${pid}"; done
echo "CACHE-TEST ${step} unpack $(( $(date +%s) - start ))s"
