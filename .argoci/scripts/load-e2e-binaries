#!/bin/bash
# Unpacks the e2e binaries built earlier in this workflow into the checkout. The
# caller sets E2E_PREBUILT so the kind targets use them rather than rebuilding.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# Not every CI image carries zstd.
if ! command -v zstd >/dev/null 2>&1; then
  $(command -v sudo) apt-get update -qq
  $(command -v sudo) apt-get install -y -qq --no-install-recommends zstd
fi
( cd /tmp && artifact pull workflow e2e-binaries.tar.zst )
# -m: the checkout is newer than the binaries' build, and make would rebuild
# whatever looks older than its sources.
tar --use-compress-program="zstd -d" -m -xf /tmp/e2e-binaries.tar.zst
rm -f /tmp/e2e-binaries.tar.zst
