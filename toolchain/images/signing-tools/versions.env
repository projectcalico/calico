# The image tag, calico/signing-tools:<version>. A published tag is never
# rebuilt, so bump it with any change to this directory. Read by make and by
# shell, so keep each line NAME=value.
SIGNING_TOOLS_VERSION=v0.2

# Stay on cosign v3: other majors store signatures differently.
COSIGN_VERSION=3.1.3
COSIGN_SHA256_AMD64=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71

SYFT_VERSION=1.54.1
SYFT_SHA256_AMD64=c069905b391cc4c20a5ba65ad5c10be2a7ba074f8ea6ad203e24d14e303dad47
