#!/bin/bash
#
# Write one secret key from the local keyring to a file, in armored form.
#
# Usage: export-secret-key <key-id> <dest-file>
#
# <key-id> is anything gpg accepts: a key id, a fingerprint or a uid.  Called
# only by publish-deb-source, into the private temporary directory it owns and
# cleans up; nothing here writes under output/.
#
# Pinentry is left enabled, so gpg-agent prompts as usual for a protected key.
# Set SECRET_KEY_PASSPHRASE_FILE for unattended use.

set -eu -o pipefail

if [ $# -ne 2 ]; then
    echo >&2 "usage: $(basename "$0") <key-id> <dest-file>"
    exit 1
fi

key_id=$1
dest=$2

gpg_args=()
if [ -n "${SECRET_KEY_PASSPHRASE_FILE:-}" ]; then
    gpg_args+=(--batch --pinentry-mode loopback
               --passphrase-file "${SECRET_KEY_PASSPHRASE_FILE}")
fi

umask 077
gpg "${gpg_args[@]}" --armor --export-secret-keys -- "${key_id}" > "${dest}"

if [ ! -s "${dest}" ]; then
    echo >&2 "[error] no secret key for '${key_id}' in this keyring"
    exit 1
fi
